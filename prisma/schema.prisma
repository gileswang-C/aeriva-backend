generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model UserEquipment {
  id          Int      @id @default(autoincrement())
  userId      String
  equipmentId Int
  environment String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id])
  

  @@unique([userId, equipmentId, environment])
  @@index([userId])
  @@index([equipmentId])
}

model Equipment {
  id           Int      @id
  name         String   @unique
  category     String
  supportsGym  Boolean  @default(true)
  supportsHome Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userEquipments UserEquipment[]
  exercises Exercise[]
}
model Exercise {
  id           Int      @id
  name         String   @unique
  category     String
  targetMuscle String
  difficulty   String
  equipmentId  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  equipment Equipment? @relation(fields: [equipmentId], references: [id])
  trainingPlanExercises TrainingPlanExercise[]

  @@index([equipmentId])
}
model TrainingPlan {
  id           Int      @id @default(autoincrement())
  userId       String
  environment  String
  targetMuscle String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exercises TrainingPlanExercise[]

  @@index([userId])
}

model TrainingPlanExercise {
  id          Int @id @default(autoincrement())
  planId      Int
  exerciseId  Int
  order       Int
  sets        Int
  reps        Int
  restSeconds Int

  plan     TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id])

  @@unique([planId, exerciseId])
  @@index([planId])
  @@index([exerciseId])
}