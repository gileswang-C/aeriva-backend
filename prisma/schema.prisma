generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model UserEquipment {
  id          Int      @id @default(autoincrement())
  userId      String
  equipmentId Int
  environment String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, equipmentId, environment])
  @@index([userId])
}