generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model UserEquipment {
  id          Int      @id @default(autoincrement())
  userId      String
  equipmentId Int
  environment String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@unique([userId, equipmentId, environment])
  @@index([userId])
  @@index([equipmentId])
}

model Equipment {
  id           Int      @id
  name         String   @unique
  category     String
  supportsGym  Boolean  @default(true)
  supportsHome Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userEquipments UserEquipment[]
  exercises      Exercise[]
}

model Exercise {
  id           Int      @id
  name         String   @unique
  category     String
  targetMuscle String
  difficulty   String
  equipmentId  Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  equipment             Equipment?             @relation(fields: [equipmentId], references: [id])
  trainingPlanExercises TrainingPlanExercise[]
  trainingAdjustments   TrainingAdjustment[]

  @@index([equipmentId])
}

model TrainingPlan {
  id           Int      @id @default(autoincrement())
  userId       String
  environment  String
  targetMuscle String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  exercises   TrainingPlanExercise[]
  sessions    TrainingSession[]
  adjustments TrainingAdjustment[]

  @@index([userId])
}

model TrainingPlanExercise {
  id             Int    @id @default(autoincrement())
  planId         Int
  exerciseId     Int
  order          Int
  sets           Int
  reps           Int
  restSeconds    Int
  targetWeightKg Float?

  plan     TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id])

  setLogs TrainingSetLog[]

  @@unique([planId, exerciseId])
  @@index([planId])
  @@index([exerciseId])
}

model TrainingSession {
  id          Int       @id @default(autoincrement())
  userId      String
  planId      Int
  status      String    @default("IN_PROGRESS")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  plan                TrainingPlan                 @relation(fields: [planId], references: [id], onDelete: Cascade)
  sets                TrainingSetLog[]
  feedback            TrainingPerformanceFeedback?
  trainingAdjustments TrainingAdjustment[]

  @@index([userId])
  @@index([planId])
}

model TrainingSetLog {
  id             Int      @id @default(autoincrement())
  sessionId      Int
  planExerciseId Int
  setNumber      Int
  reps           Int?
  weightKg       Float?
  completed      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  session      TrainingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  planExercise TrainingPlanExercise @relation(fields: [planExerciseId], references: [id])

  @@unique([sessionId, planExerciseId, setNumber])
  @@index([sessionId])
  @@index([planExerciseId])
}

model DailyBodyState {
  id               Int      @id @default(autoincrement())
  userId           String
  localDate        String
  utcOffsetMinutes Int      @default(480)
  sleepHours       Float?
  sleepQuality     Int?
  energyLevel      Int?
  sorenessLevel    Int?
  stressLevel      Int?
  painAreasJson    String?
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, localDate])
  @@index([userId])
  @@index([localDate])
}

model TrainingAdjustment {
  id                Int      @id @default(autoincrement())
  userId            String
  sessionId         Int
  exerciseId        Int
  action            String
  suggestedWeightKg Float?
  reason            String?
  createdAt         DateTime @default(now())

  session        TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise       Exercise        @relation(fields: [exerciseId], references: [id])
  trainingPlan   TrainingPlan?   @relation(fields: [trainingPlanId], references: [id])
  trainingPlanId Int?

  @@unique([sessionId, exerciseId])
  @@index([userId])
  @@index([exerciseId])
}

model TrainingPerformanceFeedback {
  id Int @id @default(autoincrement())

  sessionId Int    @unique
  userId    String

  difficultyLevel Int?
  fatigueLevel    Int?
  painLevel       Int?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
}

model MealLog {
  id               Int      @id @default(autoincrement())
  userId           String
  clientRequestId  String?  @unique
  localDate        String
  utcOffsetMinutes Int      @default(480)
  mealType         String
  source           String   @default("MANUAL")
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items MealItem[]

  @@index([userId])
  @@index([localDate])
  @@index([userId, localDate])
}

model MealItem {
  id           Int      @id @default(autoincrement())
  mealLogId    Int
  foodName     String
  caloriesKcal Float
  proteinG     Float?
  carbsG       Float?
  fatG         Float?
  quantity     Float?
  unit         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mealLog MealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)

  @@index([mealLogId])
}

model NutritionDailyTarget {
  id                Int      @id @default(autoincrement())
  userId            String   @unique
  dailyCaloriesKcal Float
  proteinG          Float?
  carbsG            Float?
  fatG              Float?
  source            String   @default("MANUAL")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
}

model BodyMetricRecord {
  id          Int      @id @default(autoincrement())
  userId      String
  weightKg    Float
  measuredAt  DateTime
  note        String?
  source      String   @default("MANUAL")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, measuredAt])
}

