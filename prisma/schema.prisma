generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model UserEquipment {
  id          Int      @id @default(autoincrement())
  userId      String
  equipmentId Int
  environment String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, equipmentId, environment])
  @@index([userId])
}
model Equipment {
  id           Int      @id
  name         String   @unique
  category     String
  supportsGym  Boolean  @default(true)
  supportsHome Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}